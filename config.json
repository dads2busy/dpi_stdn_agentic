{
  "_comment": "STDN Configuration file - specifies input data sources, model settings, and output options",
  "import_tech_list": "./data/tech_list.csv",
  "model": "openai:gpt-4.1-mini",
  "output_dir": "./output",
  "output_csv_filename": "stdns_output",

  "_comment_component_normalization_model": "Model used specifically for semantic component-name normalization mappings (more reliable model recommended)",
  "component_normalization_model": "openai:gpt-4.1",

  "materials_hs_codes_listing": "./data/hs_codes_and_usgs_names.csv",
  "materials_column_name": "Elements_Compounds",

  "usgs_database": "./data/world_mineral_commodity_reports_2022-2025_v8.db",
  "top_n_countries": 5,
  "enable_llm_fallback_cache": true,
  "llm_fallback_cache_dir": "./data/llm_fallback_cache",
  "llm_fallback_cache_ttl_hours": 720,
  "generate_country_data": false,
  "country_data_mode": "incremental",
  "materials_to_update": null,

  "years_to_query": [2024, 2023],
  "write_nulls_to_output": true,
  "topp": 0.000001,
  "materials_use_topp": true,
  "materials_iteration_count": 10,
  "materials_count_threshold": 5,

  "_comment_checkpointing": "Checkpoint/resume configuration for long-running jobs",
  "enable_checkpoints": true,
  "checkpoint_interval": 5,

  "_comment_model_flexibility": "Model provider configuration (ollama, openai, anthropic)",
  "model_provider": "ollama",
  "model_base_url": "http://localhost:11434/v1",
  "model_api_key": null,
  "model_temperature": 0.1,

  "_comment_per_agent_models": "Optional: Use different models for different agents",
  "component_model": "openai:gpt-4.1-mini",
  "materials_model": "openai:gpt-4.1-mini",
  "country_model": "openai:gpt-4.1-mini",

  "_comment_retries": "Increase generation-time output validation retries for pydantic_ai Agents (applies when the code reads this config field)",
  "agent_retries": 5,

  "_comment_visualization": "Visualization options (requires networkx, matplotlib)",
  "generate_visualizations": false,
  "visualization_output_dir": "./output/visualizations",

  "_comment_advanced": "Advanced options for power users",
  "fuzzy_material_matching": true,
  "material_match_threshold": 0.75,
  "component_validation_strict": false,
  "parallel_processing": false,
  "max_parallel_jobs": 3,

  "_comment_logging": "Logging configuration",
  "log_level": "INFO",
  "log_file": "./logs/stdn_agentic.log",
  "log_agent_responses": false,

  "_comment_performance": "Performance tuning",
  "component_timeout": 180,
  "materials_timeout": 180,
  "country_timeout": 120,
  "request_limit": 50,
  "total_tokens_limit": 100000
}
