# STDN Agentic Environment Configuration
# Copy this file to .env and fill in your values

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434/v1

# Multi-Agent Debate Configuration
ENABLE_COMPONENT_DEBATE=true
ENABLE_MATERIAL_DEBATE=true
ENABLE_COUNTRY_DEBATE=true
NUM_AGENTS_COMPONENT=3
NUM_AGENTS_MATERIAL=3
NUM_AGENTS_COUNTRY=3
MAX_DEBATE_ROUNDS=3
CONVERGENCE_THRESHOLD=0.7

# LLM Fallback Cache
ENABLE_LLM_FALLBACK_CACHE=true

# Material Tools (set to 1 to disable)
STDN_DISABLE_MATERIAL_TOOLS=1

# API Keys (required for cloud LLM providers)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
